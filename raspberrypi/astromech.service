[Unit]
Description=Astromech Droid Service
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=/home/mcgachey/code/astromech_server/raspberrypi/
ExecStart=/bin/bash /home/mcgachey/code/astromech_server/raspberrypi/bin/astromech_service.sh
Restart=always
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=Astromech
User=mcgachey
Group=mcgachey

[Install]
WantedBy=multi-user.target



